{
  "title": "LogicQA Inference Dashboard",
  "uid": "logicqa-main",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Inference Latency by Model (avg ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(nv_inference_request_duration_us[1m]) / rate(nv_inference_request_success[1m]) / 1000",
          "legendFormat": "{{model}} avg"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 2,
      "title": "Inference Throughput (req/s per model)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(nv_inference_request_success[1m])",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 3,
      "title": "GPU Utilization (%)",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "nv_gpu_utilization",
          "legendFormat": "GPU {{gpu_uuid}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      }
    },
    {
      "id": 4,
      "title": "GPU Memory Used (GB)",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "nv_gpu_memory_used_bytes / 1e9",
          "legendFormat": "Used"
        },
        {
          "datasource": "Prometheus",
          "expr": "nv_gpu_memory_total_bytes / 1e9",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "GB" }
      }
    },
    {
      "id": 5,
      "title": "Preprocessing Service RPS",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(preprocessing_requests_total{status='success'}[1m])",
          "legendFormat": "{{endpoint}} success"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(preprocessing_requests_total{status='error'}[1m])",
          "legendFormat": "{{endpoint}} error"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 6,
      "title": "Preprocessing Latency (p50 / p95)",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(preprocessing_latency_seconds_bucket[1m]))",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(preprocessing_latency_seconds_bucket[1m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 7,
      "title": "Inference Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(nv_inference_request_failure[1m])",
          "legendFormat": "{{model}} failures/s"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 8,
      "title": "Queue Duration (avg ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(nv_inference_queue_duration_us[1m]) / rate(nv_inference_request_success[1m]) / 1000",
          "legendFormat": "{{model}} queue"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    }
  ]
}
